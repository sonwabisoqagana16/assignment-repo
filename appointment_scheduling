from datetime import datetime

doctors = {
    "Dr S. Mahlasela":  ["09:00", "10:00", "11:00", "14:00"],
    "Dr A. Sangqu":     ["09:30", "10:30", "11:30", "15:00"],
    "Dr K. Monoametsi": ["08:30", "09:30", "13:00", "16:00"],
}

appointments = []  # list of dicts: {doctor, patient, date, time}


def book_appointment(patient, doctor, date, time):
    """Book an appointment if the slot is valid and free."""
    if doctor not in doctors:
        return f"❌ Unknown doctor: {doctor}"
    if time not in doctors[doctor]:
        return f"❌ {doctor} is not available at {time}. Slots: {doctors[doctor]}"

    # Prevent double-booking the same doctor/date/time
    for appt in appointments:
        if appt["doctor"] == doctor and appt["date"] == date and appt["time"] == time:
            return f"❌ Slot already taken: {doctor} on {date} at {time}"

    appointments.append({"patient": patient, "doctor": doctor, "date": date, "time": time})
    return f"✅ Booked: {patient} with {doctor} on {date} at {time}"


def view_appointments(doctor=None):
    """List all appointments, optionally filtered by doctor."""
    results = [a for a in appointments if doctor is None or a["doctor"] == doctor]
    if not results:
        return "No appointments found."
    return "\n".join(
        f"{a['date']} {a['time']} — {a['patient']} with {a['doctor']}" for a in results
    )


